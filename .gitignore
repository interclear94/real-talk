# 임시 파일
*.tmp
*.temp

# 백업 파일
*.bak
*~


# =========================================
# Local Database / Uploaded Files
# =========================================

# 로컬에서 생성되는 DB 파일
*.sqlite
*.sqlite3
*.db

# 로컬 업로드 파일
uploads/


