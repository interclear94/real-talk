# =========================================
# Dependencies
# =========================================

# 모든 위치의 node_modules 무시
node_modules/


# =========================================
# Environment Variables
# =========================================

# 모든 .env 파일 무시
.env

# .env.local, .env.development, .env.production 등
.env.*

# 단, 예시용 환경변수 파일은 Git에 포함할 수 있도록 허용
!.env.example


# =========================================
# Build / Distribution
# =========================================

# TypeScript 빌드 결과물
dist/
build/

# Vite 등의 빌드 결과물
.output/
.nuxt/
.next/


# =========================================
# Cache
# =========================================

# 각종 캐시
.cache/
.parcel-cache/
.vite/
.turbo/

# TypeScript 캐시
*.tsbuildinfo


# =========================================
# Test / Coverage
# =========================================

# 테스트 커버리지 결과
coverage/


# =========================================
# Logs
# =========================================

# 로그 파일
*.log

# npm 로그
npm-debug.log*
# pnpm 로그
pnpm-debug.log*
# yarn 로그
yarn-debug.log*
yarn-error.log*


# =========================================
# OS
# =========================================

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini


# =========================================
# IDE / Editor
# =========================================

# VS Code 개인 설정
.vscode/*

# 단, 팀에서 공유할 VS Code 설정이 있다면 허용 가능
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains
.idea/

# Vim
*.swp
*.swo


# =========================================
# Temporary Files
